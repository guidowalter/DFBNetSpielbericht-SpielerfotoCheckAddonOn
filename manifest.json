{
  "manifest_version": 3,
  "name": "Spielbericht Photo Checker",
  "version": "2.0",
  "description": "Automatically checks if all players have photos uploaded in DFB Spielbericht pages",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kadercheck – Einstellungen",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "spielbericht-photo-checker@dfbnet.org",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.dfbnet.org/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
