{
  "manifest_version": 3,
  "name": "Spielbericht Photo Checker",
  "version": "1.0",
  "description": "Automatically checks if all players have photos uploaded in DFB Spielbericht pages",
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "*://*.dfbnet.org/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
